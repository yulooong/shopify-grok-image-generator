{
  "version": 2,
  "builds": [
    { "src": "api/generate-with-furnishing.js", "use": "@vercel/node" },
    { "src": "api/generate-without-furnishing.js", "use": "@vercel/node" },
    { "src": "api/upload-preview.js", "use": "@vercel/node" },
    { "src": "api/generate-pdf.js", "use": "@vercel/node" },
    { "src": "api/generate-svg.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/generate-with-furnishing", "dest": "/api/generate-with-furnishing.js" },
    { "src": "/api/generate-without-furnishing", "dest": "/api/generate-without-furnishing.js" },
    { "src": "/api/upload-preview", "dest": "/api/upload-preview.js" },
    { "src": "/api/generate-pdf", "dest": "/api/generate-pdf.js" },
    { "src": "/api/generate-svj", "dest": "/api/generate-svj.js" }
  ]
}
